{
  "name": "fss-marketing-demo",
  "private": true,
  "description": "Unofficial demo. Test tooling only; the site itself has no packages and no build step.",
  "scripts": {
    "test": "npm run test:unit && npm run test:relay && npm run test:parity",
    "test:relay": "node --import ./relay/register.mjs --test relay/worker.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:parity": "playwright test",
    "test:firefox": "playwright test --project=firefox-desktop",
    "size": "node perf/size.mjs",
    "perf:staff": "node perf/staff-scroll.mjs",
    "test:live": "BASE_URL=https://jefepapi.github.io/fss-marketing-demo/ playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
